#!name=BiliBili每日等级任务
#!desc=定时任务及Cookie获取
#!author=MartinsKing（@ClydeTime）
#!homepage=https://github.com/ClydeTime/BiliBili/tree/master
#!icon=https://raw.githubusercontent.com/ClydeTime/BiliBili/main/database/icon_Avatar.png
#!category=MK
#!arguments=RunTime:30 7 * * *,script_APP:B站Cookie(APP),script_QrCode:#B站Cookie(扫码),bigPoint:#B站观看剧集大积分
#!arguments-desc=RunTime：每日等级任务的执行时间（cron 表达式，默认每天早上 7:30）\nscript_APP：APP 抓 Cookie 开关，默认开启；改为 # 开头即关闭，改成任意名称即开启\nscript_QrCode：扫码抓 Cookie 开关，默认关闭（#）；改成任意名称开启，与 APP 方式二选一、不可同时开启\nbigPoint：大会员观看剧集大积分定时任务，默认关闭（#）；改成任意名称开启，非大会员忽略

# 现将获取cookie与定时任务合并为一个模块
# 使用APP获取cookie,保持B站Cookie(APP)开启,如检测到cookie变更会自动更新,解决cookie经常过期的问题(cookie仍有效不提醒更新)
# 使用扫码获取cookie,保持B站Cookie(扫码)开启,打开APP后,根据推送提示操作获取cookie,此方式cookie存活时间较长,使用后需关闭脚本,cookie失效后再次打开即可
# 用户可选择自行开启或关闭,两种获取方式不可兼用,如需关闭,点击模块右侧三个点或长按模块,选择编辑参数,将script_QrCode或script_APP设置为#开头即可
# 大会员用户可选择开启bigPoint定时任务(把默认值开头的#去掉),以此获取观看剧集大积分,非大会员用户忽略即可
# 任务奖励：经验值/硬币/大会员积分/年度会员领取B币等
# ================ Boxjs订阅 ================
# 订阅地址：https://raw.githubusercontent.com/ClydeTime/BiliBili/main/boxjs/BiliBili.boxjs.json

[Script]
B站每日任务 = type=cron,cronexp="{{{RunTime}}}",script-path=https://raw.githubusercontent.com/Juziiz/JuziiLab/main/deps/raw.githubusercontent.com/ClydeTime/BiliBili/main/js/BiliBiliDailyBonus.js,wake-system=1,timeout=15

{{{bigPoint}}} = type=cron,cronexp=41 7 * * *,script-path=https://raw.githubusercontent.com/Juziiz/JuziiLab/main/deps/raw.githubusercontent.com/ClydeTime/BiliBili/main/js/BiliBiliDailyBonus.js,wake-system=1,timeout=15

{{{script_QrCode}}} = type=http-response,pattern=^https?:\/\/app\.bilibili\.com\/x\/resource\/fingerprint\?,script-path=https://raw.githubusercontent.com/Juziiz/JuziiLab/main/deps/raw.githubusercontent.com/ClydeTime/BiliBili/main/js/BiliBiliDailyBonus.js,requires-body=0,timeout=30

{{{script_APP}}} = type=http-request,pattern=^https?:\/\/app\.bilibili\.com\/x\/resource\/fingerprint\?,script-path=https://raw.githubusercontent.com/Juziiz/JuziiLab/main/deps/raw.githubusercontent.com/ClydeTime/BiliBili/main/js/BiliBiliDailyBonus.js,requires-body=0

[MITM]
hostname = %APPEND% app.bilibili.com
