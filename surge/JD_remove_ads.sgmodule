#!name=京东去广告
#!desc=移除京东开屏广告，精简我的页面产品推广。在京东商品详情页可查看历史价格。首次使用需先安装慢慢买 App，打开慢慢买的我的页面捕获令牌（提示获取ck成功），之后商品详情页才能查看比价。
#!author=RuCu6[https://github.com/RuCu6], WeiGiegie[https://github.com/WeiGiegie], wish[https://github.com/mist-whisper]
#!category=去广告
#!date=2026-02-02 20:35:00
#!arguments=京东比价:京东比价
#!arguments-desc=京东比价：京东比价开关，默认开启；改为 # 开头即关闭，改回任意名称即开启。关闭后商品详情页不再显示历史价格，去广告部分不受影响。捕获令牌单独常开，不受此开关影响。

[Rule]
DOMAIN, dns.jd.com, REJECT
IP-CIDR, 101.124.19.122/32, REJECT, no-resolve
IP-CIDR6, 2402:db40:5100:1011::5/128, REJECT, no-resolve
URL-REGEX, "^http:\/\/\w{32}\.jddebug\.com\/diagnose\?", REJECT

[Map Local]
^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=(searchBoxWord|stationPullService|uniformRecommend[06]) data-type=text data="{}" status-code=200
^https?:\/\/m\.360buyimg\.com\/mobilecms\/s1125x2436_jfs data-type=text data=" " status-code=200

[Script]
移除京东广告 = type=http-response, pattern=^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=(deliverLayer|getTabHomeInfo|myOrderInfo|orderTrackBusiness|personinfoBusiness|start|welcomeHome), script-path=https://resource.wuyra.com/Script/JD/JD_remove_ads.js, requires-body=true
捕获令牌 = type=http-request, pattern=^https?:\/\/apapia-sqk-weblogic\.manmanbuy\.com\/baoliao\/center\/menu$, script-path=https://raw.githubusercontent.com/wf021325/qx/main/js/jd_price.js, requires-body=true, timeout=10
{{{京东比价}}} = type=http-response, pattern=^https?:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html, script-path=https://raw.githubusercontent.com/wf021325/qx/main/js/jd_price.js, requires-body=true, timeout=10

[MITM]
hostname = %APPEND% in.m.jd.com, m.360buyimg.com, apapia-sqk-weblogic.manmanbuy.com
